# ============================================================================
# Cineforge environment — copy to .env and fill in. NEVER commit .env.
# ============================================================================

# --- app ---
ENVIRONMENT=dev
DEBUG=true
APP_NAME=Cineforge API

# --- auth (generate: openssl rand -hex 32) ---
SECRET_KEY=CHANGE_ME_generate_a_random_32_byte_hex
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- CORS (frontend origins, comma-free JSON list handled by pydantic) ---
CORS_ORIGINS=["http://localhost:3000"]

# --- database (local docker, or Supabase free Postgres connection string) ---
DATABASE_URL=postgresql+asyncpg://cineforge:cineforge@localhost:5432/cineforge

# --- redis (queue + cache + SSE pubsub) ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- storage ---
STORAGE_ROOT=storage

# ============================================================================
# ai_engine / GPU worker (read on the GPU box — Colab/Kaggle/local)
# ============================================================================
COMFYUI_URL=http://127.0.0.1:8188
OLLAMA_HOST=http://localhost:11434

# LLM (Ollama-default, OpenAI-compatible fallback)
CINEFORGE_LLM_PROVIDER=ollama
CINEFORGE_LLM_MODEL=llama3

# backend adapters
CINEFORGE_IMAGE_BACKEND=comfyui
CINEFORGE_ANIM_BACKEND=comfyui
CINEFORGE_VOICE_BACKEND=xtts
CINEFORGE_MUSIC_BACKEND=musicgen
CINEFORGE_COMPOSER=ffmpeg

# VRAM / performance (T4 16GB / RTX 3060 12GB)
CINEFORGE_VRAM_GB=12
CINEFORGE_FP16=1
CINEFORGE_CPU_OFFLOAD=1
CINEFORGE_VAE_TILING=1
CINEFORGE_MODEL_CACHE=storage/models
