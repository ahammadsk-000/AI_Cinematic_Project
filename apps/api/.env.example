# =============================================================================
# CLOUD MODE for the local backend  (Supabase Postgres + Upstash Redis)
#
# Copy this file to  apps/api/.env  and fill in the real values. When this .env
# exists, ai_cenematic_pro.bat runs the backend against these cloud services
# instead of local Docker/SQLite — so a Colab/Kaggle GPU worker pointed at the
# SAME values will share the queue and render your jobs.
#
# Put the IDENTICAL DATABASE_URL + CELERY_BROKER_URL into the Colab notebook.
# =============================================================================

ENVIRONMENT=dev
SECRET_KEY=replace-with-openssl-rand-hex-32

# --- Supabase Postgres ---------------------------------------------------------
# Supabase dashboard -> Project Settings -> Database -> Connection string.
# Use the "Session pooler" (or Direct) URI, then prepend the async driver:
#   postgresql+asyncpg://postgres.<ref>:<PASSWORD>@<host>.pooler.supabase.com:5432/postgres
# (The worker converts +asyncpg -> psycopg2 automatically and adds sslmode=require.)
DATABASE_URL=postgresql+asyncpg://postgres.<ref>:<PASSWORD>@<host>.pooler.supabase.com:5432/postgres

# --- Upstash Redis -------------------------------------------------------------
# Upstash console -> your database -> copy the rediss:// URL.
# IMPORTANT: Upstash free tier has only ONE database (db 0). Do NOT use /1 or /2
# (they error). Point all three at the SAME url — Celery namespaces its own keys
# and our progress pub/sub uses per-job channel names, so they coexist safely.
REDIS_URL=rediss://default:<PASSWORD>@<name>.upstash.io:6379
CELERY_BROKER_URL=rediss://default:<PASSWORD>@<name>.upstash.io:6379
CELERY_RESULT_BACKEND=rediss://default:<PASSWORD>@<name>.upstash.io:6379

# Reaper re-queues jobs whose worker died (safe to leave on).
ENABLE_REAPER=true

# Local frontend origin (don't change for local dev).
CORS_ORIGINS=["http://localhost:3000"]
