{
  "_meta": {
    "title": "Cineforge SVD img2vid (real motion)",
    "description": "Stable Video Diffusion: animates an input still into real motion. Uses ComfyUI BUILT-IN SVD nodes (ImageOnlyCheckpointLoader, SVD_img2vid_Conditioning, VideoLinearCFGGuidance) + VideoHelperSuite for mp4 output. Requires the SVD checkpoint at models/checkpoints/svd.safetensors. The backend uploads the SDXL still to ComfyUI and injects its name into node 10 (LoadImage). Injection map: init_image=10, fps=6/frame_rate, width/height=3, seed=5 (video_frames stays 14 — svd's native length).",
    "format": "comfyui-api"
  },
  "1": {
    "class_type": "ImageOnlyCheckpointLoader",
    "inputs": { "ckpt_name": "svd.safetensors" }
  },
  "10": {
    "class_type": "LoadImage",
    "inputs": { "image": "PLACEHOLDER_INIT_IMAGE" }
  },
  "3": {
    "class_type": "SVD_img2vid_Conditioning",
    "inputs": {
      "width": 1024,
      "height": 576,
      "video_frames": 14,
      "motion_bucket_id": 127,
      "fps": 7,
      "augmentation_level": 0.0,
      "clip_vision": ["1", 1],
      "init_image": ["10", 0],
      "vae": ["1", 2]
    }
  },
  "4": {
    "class_type": "VideoLinearCFGGuidance",
    "inputs": { "min_cfg": 1.0, "model": ["1", 0] }
  },
  "5": {
    "class_type": "KSampler",
    "inputs": {
      "seed": 0,
      "steps": 20,
      "cfg": 2.5,
      "sampler_name": "euler",
      "scheduler": "karras",
      "denoise": 1.0,
      "model": ["4", 0],
      "positive": ["3", 0],
      "negative": ["3", 1],
      "latent_image": ["3", 2]
    }
  },
  "8": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["5", 0], "vae": ["1", 2] }
  },
  "6": {
    "class_type": "VHS_VideoCombine",
    "inputs": {
      "images": ["8", 0],
      "frame_rate": 8,
      "loop_count": 0,
      "filename_prefix": "cineforge_svd",
      "format": "video/h264-mp4",
      "pingpong": false,
      "save_output": true
    }
  }
}
