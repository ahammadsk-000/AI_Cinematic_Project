{
  "_meta": {
    "title": "Cineforge AnimateDiff img2vid",
    "description": "Image-conditioned AnimateDiff. REQUIRES the ComfyUI-AnimateDiff-Evolved and VideoHelperSuite custom nodes. The backend injects via node_map.json (init_image=10, positive=2, negative=3, frames=7/batch_size, fps=6/frame_rate, seed=5/seed). Generates SHORT windows per scene to stay within T4 VRAM.",
    "format": "comfyui-api"
  },
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": { "ckpt_name": "sd_xl_base_1.0.safetensors" }
  },
  "2": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "PLACEHOLDER_POSITIVE", "clip": ["1", 1] }
  },
  "3": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "PLACEHOLDER_NEGATIVE", "clip": ["1", 1] }
  },
  "4": {
    "class_type": "ADE_AnimateDiffLoaderGen1",
    "inputs": { "model_name": "mm_sd_v15_v2.ckpt", "beta_schedule": "sqrt_linear (AnimateDiff)", "model": ["1", 0] }
  },
  "7": {
    "class_type": "EmptyLatentImage",
    "inputs": { "width": 768, "height": 432, "batch_size": 16 }
  },
  "10": {
    "class_type": "LoadImage",
    "inputs": { "image": "PLACEHOLDER_INIT_IMAGE" }
  },
  "5": {
    "class_type": "KSampler",
    "inputs": {
      "seed": 0,
      "steps": 20,
      "cfg": 7.0,
      "sampler_name": "euler",
      "scheduler": "normal",
      "denoise": 0.75,
      "model": ["4", 0],
      "positive": ["2", 0],
      "negative": ["3", 0],
      "latent_image": ["7", 0]
    }
  },
  "8": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["5", 0], "vae": ["1", 2] }
  },
  "6": {
    "class_type": "VHS_VideoCombine",
    "inputs": {
      "images": ["8", 0],
      "frame_rate": 12,
      "loop_count": 0,
      "filename_prefix": "cineforge_clip",
      "format": "video/h264-mp4",
      "pingpong": false,
      "save_output": true
    }
  }
}
